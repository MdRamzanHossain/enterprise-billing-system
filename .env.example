# Application Environment Variables
# Copy this file to .env on your server

# HTTP Port (Default: 3000)
PORT=3000

# Network Host to bind to (0.0.0.0 listens on all interfaces; 127.0.0.1 for local only behind reverse proxy)
HOST=0.0.0.0

# Node Environment
NODE_ENV=production

# Custom Persistent Data Directory (Optional - default is ./data)
# DATA_DIR=/var/data/sec-gadgets
